{
  "name": "harvest-havoc-scouting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first scouting + strategy system for Saxon Robotics (FRC 611 + FRC 526) at Blair BunnyBots 2026 (Harvest Havoc).",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "node scripts/brand-manifest.mjs && node scripts/build-worker.mjs && next dev",
    "build": "node scripts/brand-manifest.mjs && node scripts/build-worker.mjs && next build && node scripts/build-sw.mjs",
    "start": "node scripts/serve.mjs 3000",
    "brand": "node scripts/brand.mjs && node scripts/brand-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run supabase/tests",
    "test:e2e": "playwright test --trace off",
    "seed:sql": "node scripts/generate-seed.mjs",
    "keepalive": "node scripts/keepalive.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@supabase/supabase-js": "2.119.2",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "fflate": "0.8.3",
    "lottie-web": "^5.13.0",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "papaparse": "5.7.1",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "6.2.8",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
