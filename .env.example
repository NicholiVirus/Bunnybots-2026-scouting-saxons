# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local (local dev) and set the same values in Vercel /
# Cloudflare Pages → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API. These two are SAFE to expose in the browser:
# Row-Level Security in supabase/migrations decides who can read/write what.
# Leave both empty to run in "local-only" mode (single device + QR transfer).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional default for The Bunnybots Alliance base URL (449's results site).
# Admins can change it any time in Admin → Data sources, no redeploy needed.
NEXT_PUBLIC_TBA_CLONE_URL=

# ── Scripts only (NEVER prefix these with NEXT_PUBLIC_) ──────────────────────
# Used by `npm run loadtest` and `npm run keepalive` from your laptop / CI.
SUPABASE_URL=
SUPABASE_ANON_KEY=
